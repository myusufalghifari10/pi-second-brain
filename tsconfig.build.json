{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"allowImportingTsExtensions": false,
		"declaration": true,
		"noEmit": false,
		"outDir": "dist",
		"rewriteRelativeImportExtensions": true
	},
	"include": ["index.ts", "src/**/*.ts", "eval/**/*.ts"],
	"exclude": ["node_modules", "dist", "test", "spike"]
}
