{
	"name": "pi-second-brain",
	"version": "1.0.0",
	"description": "pi-second-brain: local-first RAG memory for Pi coding agents - hybrid BM25+vector search, code/math/chem-aware chunking, cross-encoder reranking, PDF/URL/OCR ingestion, diagnostics. Hardened fork of nczz/pi-knowledge.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"pi-second-brain": "dist/src/cli.js"
	},
	"pi": {
		"extensions": [
			"./extension.js"
		],
		"skills": [
			".pi/skills/*.md"
		]
	},
	"files": [
		"extension.js",
		"dist/",
		".pi/",
		"skills/",
		"docs/configuration.md",
		"docs/offline-mode.md",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"omp",
		"omp-sh",
		"ai-agent",
		"coding-agent",
		"knowledge-base",
		"local-first",
		"retrieval-augmented-generation",
		"hybrid-search",
		"bm25",
		"vector-search",
		"semantic-search",
		"code-search",
		"developer-tools",
		"rag",
		"embeddings",
		"mcp",
		"model-context-protocol",
		"claude-code",
		"codex",
		"cline",
		"research-assistant"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "npm run build",
		"check": "biome check --write --error-on-warnings .",
		"prepack": "npm run typecheck && npm run build",
		"test": "vitest --run test/unit/",
		"test:e2e": "vitest --run test/e2e/",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"bench": "vitest bench test/bench/",
		"eval": "npm run -s build && node dist/eval/run.js"
	},
	"dependencies": {
		"@huggingface/transformers": "3.8.1",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"better-sqlite3": "12.11.1",
		"ignore": "7.0.5",
		"mammoth": "1.12.0",
		"tree-sitter": "0.21.1",
		"tree-sitter-bash": "0.21.0",
		"tree-sitter-c": "0.21.4",
		"tree-sitter-cpp": "0.23.2",
		"tree-sitter-go": "0.21.2",
		"tree-sitter-java": "0.23.5",
		"tree-sitter-javascript": "0.23.1",
		"tree-sitter-python": "0.21.0",
		"tree-sitter-qmljs": "0.3.1",
		"tree-sitter-rust": "0.21.0",
		"tree-sitter-typescript": "0.23.2",
		"unpdf": "1.6.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/better-sqlite3": "7.6.13",
		"@types/node": "22.19.19",
		"typescript": "5.9.3",
		"vitest": "3.2.4"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/myusufalghifari10/pi-second-brain.git"
	},
	"allowScripts": {
		"better-sqlite3@12.11.1": true,
		"tree-sitter@0.21.1": true,
		"esbuild@0.27.7": true,
		"onnxruntime-node@1.21.0": true,
		"protobufjs@7.6.4": true,
		"sharp@0.34.5": true,
		"tree-sitter-go@0.21.2": true,
		"tree-sitter-c@0.21.4": true,
		"tree-sitter-bash@0.21.0": true,
		"tree-sitter-java@0.23.5": true,
		"tree-sitter-javascript@0.23.1": true,
		"tree-sitter-python@0.21.0": true,
		"tree-sitter-qmljs@0.3.1": true,
		"tree-sitter-rust@0.21.0": true,
		"tree-sitter-cpp@0.23.2": true,
		"tree-sitter-typescript@0.23.2": true
	},
	"homepage": "https://github.com/myusufalghifari10/pi-second-brain#readme",
	"bugs": "https://github.com/myusufalghifari10/pi-second-brain/issues",
	"author": "myusufalghifari10"
}
